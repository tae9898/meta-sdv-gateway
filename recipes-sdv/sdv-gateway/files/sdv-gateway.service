[Unit]
Description=SDV Multi-protocol Diagnostic Gateway
Requires=can0-setup.service
After=can0-setup.service network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/sdv-gateway
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security (relaxed for embedded demo)
#ProtectSystem=strict
#ProtectHome=yes
#NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
